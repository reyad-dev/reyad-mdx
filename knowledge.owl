  <rdf:Description rdf:about="urn:ontolink:project:mdx-reader-1ce34f1/consider-windows-signing">
    <rdf:type rdf:resource="urn:ontolink:Recommendation" />
    <ol:affects rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1/release-pipeline" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Local installers and portable executables have no Authenticode signature. Microsoft documents SmartScreen reputation checks for files and certificates. No signing configuration or credential was supplied.</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-19T12:54:07.959522+00:00</ol:createdAt>
    <ol:status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PROPOSED</ol:status>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evaluate trusted Windows code signing for future distributed installer and portable builds.</ol:summary>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:mdx-reader-1ce34f1/coverage-limit">
    <rdf:type rdf:resource="urn:ontolink:Warning" />
    <ol:affects rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-17T08:40:03.635483+00:00</ol:createdAt>
    <ol:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INFO</ol:severity>
    <ol:status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OPEN</ol:status>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Knowledge coverage is the accessible local repository, release notes and current checks. Prior chats/external issue backlog and external release receipts are unavailable in this session. Preserve the distinction between history claims and tested facts.</ol:summary>
  </rdf:Description>
