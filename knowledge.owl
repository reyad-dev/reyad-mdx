    <ol:status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">READY</ol:status>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Run Gradle assembleDebug/lintDebug and npm run android:test with a configured SDK, unlocked device/emulator and installed debug APK. Record commands, device/build identity and logs. Browser bridge tests alone are insufficient.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Collect current native Android build, lint and device regression evidence</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1/agent-handoff" />
