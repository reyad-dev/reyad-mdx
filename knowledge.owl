  <rdf:Description rdf:about="urn:ontolink:project:mdx-reader-1ce34f1/portable-knowledge">
    <rdf:type rdf:resource="urn:ontolink:Decision" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core.autocrlf=true would rewrite source/proof hashes; bundled coordinator requires Python 3.10+ standard library only.</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-17T09:15:25.452038+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">User authorized pushing all project work to origin/main for resuming on another device. Track installed suite, graph, durable records/proofs, agent entry points and original distribution snapshots as ordinary files. Preserve exact source/proof bytes through Git attributes. Build/dependency caches and nested .git metadata remain machine-local.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Version the complete project-local ontology state and byte-preserving inputs</ol:title>
  </rdf:Description>
