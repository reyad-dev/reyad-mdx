  <rdf:Description rdf:about="urn:ontolink:project:mdx-reader-1ce34f1/android-host">
    <rdf:type rdf:resource="urn:ontolink:Contract" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-17T08:40:47.332535+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Native Android source is under android/app/src/main. Browser bridge tests are simulated; native build/device verification remains open.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Android native WebView and bridge</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1/source-023" />
    <ol:usesArtifact rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1/source-034" />
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:mdx-reader-1ce34f1/appearance-release-consolidation">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-19T13:01:56.892255+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use Sepia and the bundled Almarai font for default appearance, publish recent changes on GitHub, verify Android contains the shared updates, and keep a single public release history.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ship Sepia and Almarai defaults and consolidate release documentation</ol:title>
  </rdf:Description>
