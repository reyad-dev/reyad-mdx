    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Opening another Windows file creates a separate document window. Menus, file dialogs, save state, close prompts and undo state belong to their originating window.</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1/changelog-source" />
