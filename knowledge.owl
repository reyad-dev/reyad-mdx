  <rdf:Description rdf:about="urn:ontolink:project:mdx-reader-1ce34f1/release-132-policy">
    <rdf:type rdf:resource="urn:ontolink:Decision" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Users keep established preferences; the existing Android GitHub release updater needs a higher release version and the existing signing identity.</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-19T13:02:01.490568+00:00</ol:createdAt>
    <ol:satisfies rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1/appearance-release-consolidation" />
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Version 1.3.2 ships shared price rendering and highlights with Sepia/Almarai defaults. Keep explicit and previously saved font/theme values. Consolidate public notes into CHANGELOG.md and retain the historical import snapshot under .ontolink.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ship a patch release and retain saved appearance choices</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:mdx-reader-1ce34f1/release-132-published">
    <rdf:type rdf:resource="urn:ontolink:Event" />
    <ol:affects rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-19T13:07:03.500079+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pushed 4a6f3fb841f56c3c813a28202861fbd9db5783d9 and tag v1.3.2. GitHub published all four assets and deployed Pages. The signed Android APK passed certificate, digest, and asset checks. The historical OntoLink Build obligation is still open, so this external receipt is recorded as an event.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Published and verified ReyadMDX 1.3.2</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1/release-132-github-handoff" />
  </rdf:Description>
