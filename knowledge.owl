    <ol:proofPath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">.ontolink/proofs/windows-update-2026-11-21-upgrade.txt</ol:proofPath>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Initial isolated Playwright launch inherited ELECTRON_RUN_AS_NODE. The subsequent upgrade retry removed the variable and passed.</ol:summary>
