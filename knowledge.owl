    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Android lists available bundled fonts and the system default instead of unavailable desktop font families.</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1/changelog-source" />
