    <ol:requiredKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">implementation</ol:requiredKind>
    <ol:status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DONE</ol:status>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Documented historical implementation: [1.3.1] - 2026-11-15; Fixed; CHANGELOG.md:11. DONE accepts retrospective import/provenance only; current behavior is covered only where a named test exists. Original execution receipts unavailable.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">New and Close document actions clear the current draft and undo history after confirming unsaved changes. Deliberately closed Android documents stay closed after restarting, and consumed file/share intents are not replayed on Activity recreation.</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1/changelog-source" />
    <ol:usesArtifact rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1/source-manifest" />
  </rdf:Description>
