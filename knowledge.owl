    <ol:belongsTo rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-17T09:15:25.452038+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">User authorized pushing all project work to origin/main for resuming on another device. Track installed suite, graph, durable records/proofs, agent entry points and original distribution snapshots as ordinary files. Preserve exact source/proof bytes through Git attributes. Build/dependency caches and nested .git metadata remain machine-local.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Version the complete project-local ontology state and byte-preserving inputs</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:mdx-reader-1ce34f1/preview-highlight-storage">
    <rdf:type rdf:resource="urn:ontolink:Decision" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The existing file save, draft, history, and export paths can retain document annotations across hosts. Ambiguous matches after text edits stay hidden.</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-19T12:53:21.577514+00:00</ol:createdAt>
    <ol:satisfies rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1/preview-price-highlighting-request" />
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Color selections in preview or split view. Store quote, surrounding text, and position in a versioned trailing Markdown comment while showing only the text body in the editor.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Save preview highlights with Markdown files</ol:title>
  </rdf:Description>
