    <ol:belongsTo rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-17T08:39:51.849103+00:00</ol:createdAt>
