  <rdf:Description rdf:about="urn:ontolink:project:mdx-reader-1ce34f1/windows-authenticode-signing">
    <rdf:type rdf:resource="urn:ontolink:Recommendation" />
    <ol:affects rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Published 1.3.2 setup is NotSigned and Microsoft SmartScreen uses publisher and file reputation. Trusted signing can still show reputation warnings for new files.</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-21T12:16:37.615674+00:00</ol:createdAt>
    <ol:status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PROPOSED</ol:status>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use one trusted Authenticode signing identity for future Windows executables and installers. The updated Windows build is local and publication remains pending.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use trusted Windows release signing</ol:title>
    <ol:usesArtifact rdf:resource="urn:ontolink:project:mdx-reader-1ce34f1/windows-update-handoff" />
  </rdf:Description>
